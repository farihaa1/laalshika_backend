{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",

    "ignoreDeprecations": "6.0",

    "esModuleInterop": true,

    "strict": true,
    "skipLibCheck": true,

    "sourceMap": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },

  "include": ["src/**/*.ts"],

  "exclude": ["node_modules", "dist", "src/api"]
}
